{
  "sourceLanguage": "en",
  "strings": {
    "A GitHub star helps others find the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub star helps others find the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stern auf GitHub hilft anderen, die App zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étoile sur GitHub aide les autres à découvrir l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estrella en GitHub ayuda a otros a descubrir la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stella su GitHub aiuta gli altri a trovare l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub のスターは、他の人がアプリを見つけるのに役立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上点亮一颗星，帮助更多人发现这款 App。"
          }
        }
      }
    },
