        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard"
          }
        }
      }
    },
    "CleanYourBoard checks the official update feed; no other data is sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard checks the official update feed; no other data is sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard prüft nur den offiziellen Update-Feed; keine anderen Daten werden gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard vérifie uniquement le flux de mise à jour officiel ; aucune autre donnée n’est envoyée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard solo consulta el feed oficial de actualizaciones; no se envía ningún otro dato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard verifica solo il feed ufficiale degli aggiornamenti; nessun altro dato viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard は公式のアップデートフィードのみを確認します。他のデータは送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CleanYourBoard 仅查询官方更新源；不会发送任何其他数据。"
          }
        }
      }
    },
    "CleanYourBoard needs to restart to switch the language to %@.": {
      "extractionState": "manual",
      "localizations": {
