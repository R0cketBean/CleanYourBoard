    "All keys, including F1–F12, are blocked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tasten – auch F1–F12 – werden blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All keys, including F1–F12, are blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las teclas, incluidas F1–F12, están bloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les touches, y compris F1–F12, sont bloquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tasti, inclusi F1–F12, sono bloccati."
          }
