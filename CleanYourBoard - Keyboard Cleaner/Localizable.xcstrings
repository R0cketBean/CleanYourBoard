    "To safely block all keys—including F1–F12—CleanYourBoard needs access to Accessibility.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit alle Tasten – auch F1–F12 – sicher blockiert werden, benötigt CleanYourBoard Zugriff auf die Bedienungshilfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To safely block all keys—including F1–F12—CleanYourBoard needs access to Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear todas las teclas de forma segura, incluidas F1–F12, CleanYourBoard necesita acceso a Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour bloquer toutes les touches en toute sécurité — y compris F1–F12 — CleanYourBoard a besoin d’un accès aux fonctionnalités d’accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per bloccare in sicurezza tutti i tasti — inclusi F1–F12 — CleanYourBoard ha bisogno dell’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "F1〜F12を含むすべてのキーを安全にブロックするには、CleanYourBoardにアクセシビリティへのアクセス許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了安全屏蔽所有按键（包括 F1–F12），CleanYourBoard 需要「辅助功能」权限。"
          }
        }
      }
    },
